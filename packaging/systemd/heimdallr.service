[Unit]
Description=Heimdallr DNS - Watcher at the Bifrost (OSL-3.0, pure ring)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=heimdallr
Group=heimdallr
ExecStart=/opt/heimdallr/heimdallr --config /etc/heimdallr/config.toml
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/heimdallr /etc/heimdallr /var/lib/heimdallr /var/log/heimdallr

[Install]
WantedBy=multi-user.target
