; Heimdallr template — reverse zone
; Install to: /etc/heimdallr/zones/<network>.zone
; Edit SOA, NS, PTR records for your network.

$ORIGIN {REVERSE_NAME}
$TTL 3600

@       IN  SOA ns1.example.test. admin.example.test. (
            2026082901  ; serial (YYYYMMDDNN)
            3600        ; refresh
            900         ; retry
            604800      ; expire
            86400       ; minimum
        )

@       IN  NS  ns1.example.test.
@       IN  NS  ns2.example.test.

; PTR records — replace with your hostnames
;1.0.0  IN  PTR ns1.example.test.
;2.0.0  IN  PTR ns2.example.test.
