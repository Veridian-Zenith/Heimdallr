$ORIGIN example.test.
$TTL 3600

@       IN  SOA ns1.example.test. admin.example.test. (
            2026082901  ; serial
            3600        ; refresh (1h)
            900         ; retry (15m)
            604800      ; expire (1w)
            86400       ; minimum (1d)
        )

; Nameservers
@       IN  NS  ns1.example.test.
@       IN  NS  ns2.example.test.

; A records
ns1     IN  A   10.0.0.1
ns2     IN  A   10.0.0.2
@       IN  A   10.0.0.10
www     IN  A   10.0.0.10
mail    IN  A   10.0.0.25

; AAAA
ns1     IN  AAAA    fd00::1
@       IN  AAAA    fd00::10
www     IN  AAAA    fd00::10

; MX
@       IN  MX  10  mail.example.test.

; CNAME
ftp     IN  CNAME   www.example.test.

; TXT
@       IN  TXT "v=spf1 mx a -all"
_dmarc  IN  TXT "v=DMARC1; p=reject; rua=mailto:admin@example.test."

; SRV (example: XMPP)
_xmpp-client._tcp  IN  SRV 5 0 5222 xmpp.example.test.
_xmpp-server._tcp  IN  SRV 5 0 5269 xmpp.example.test.
xmpp    IN  A   10.0.0.30
